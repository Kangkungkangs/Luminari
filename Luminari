    UDim2.fromScale(0.05, 0.83),
    Color3.fromRGB(255, 50, 50)
)

countdown.ZIndex = 20

--==================================================
-- GLITCH BARS
--==================================================

local glitchBars = {}

for i = 1, 12 do
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, math.random(2, 8))
    bar.Position = UDim2.fromScale(0, math.random())
    bar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    bar.BackgroundTransparency = 0.55
    bar.BorderSizePixel = 0
    bar.ZIndex = 25
    bar.Parent = root

    table.insert(glitchBars, bar)
end

--==================================================
-- ANIMATION ENGINE
--==================================================

local running = true
local startTime = os.clock()

local connection

connection = RunService.RenderStepped:Connect(function()
    if not running or not gui.Parent then
        return
    end

    local elapsed = os.clock() - startTime

    gradient.Rotation = (elapsed * 35) % 360

    -- Main title animation
    title.Rotation = math.sin(elapsed * 8) * 2
    titleShadow.Position = UDim2.fromScale(
        0.035 + math.random(-2, 2) / 1000,
        0.33 + math.random(-2, 2) / 1000
    )

    -- Text glitch
    for i, label in ipairs(texts) do
        if i % 4 == 0 then
            label.Position = UDim2.fromScale(
                math.random(),
                math.random()
            )
        end
    end

    -- Glitch bars
    for _, bar in ipairs(glitchBars) do
        bar.Position = UDim2.fromScale(
            0,
            math.random()
        )

        bar.BackgroundTransparency = math.random(35, 85) / 100
    end

    -- Scanline movement
    for _, line in ipairs(scanlines) do
        line.BackgroundTransparency =
            math.random(80, 95) / 100
    end

    -- Warning animation
    panel.Rotation = math.sin(elapsed * 5) * 1.2
end)

--==================================================
-- COUNTDOWN SEQUENCE
--==================================================

task.spawn(function()
    tween(
        panel,
        0.8,
        {Size = UDim2.fromScale(0.82, 0.2)},
        Enum.EasingStyle.Back
    )

    for i = CONFIG.DURATION, 1, -1 do
        countdown.Text = "SYSTEM TAKEOVER: " .. i

        warning.Text = i % 2 == 0
            and "!!! PEARKS GAY !!!"
            or "PEARKS GAY DETECTED"

        task.wait(1)
    end

    -- FINAL WARNING
    warning.Text = "ACCOUNT WARNING"
    subtitle.Text = "PEARKS GAY HAS FINISHED"

    countdown.Text = "FINAL SEQUENCE"

    tween(
        panel,
        0.5,
        {BackgroundColor3 = Color3.fromRGB(160, 0, 0)}
    )

    task.wait(CONFIG.FINAL_DELAY)

    -- STOP ANIMATIONS
    running = false

    if connection then
        connection:Disconnect()
    end

    -- FINAL KICK
    player:Kick(
        "LU PUNYA WAKTU 24JAM UNTUK MENEBUS AKUN ATAU AKUN ANDA SAYA HACK."
    )
end)
