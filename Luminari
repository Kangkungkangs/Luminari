    countdown.Text = tostring(i)
    countdown.TextColor3 = Color3.fromRGB(
        255,
        math.random(0, 80),
        0
    )

    TweenService:Create(
        countdown,
        TweenInfo.new(0.25, Enum.EasingStyle.Back),
