        for _, line in ipairs(scanlines) do
            line.BackgroundTransparency =
                math.random(75, 95) / 100
        end

        for _, bar in ipairs(glitchBars) do
            bar.Visible = math.random(1, 3) == 1

            if bar.Visible then
                bar.Position = UDim2.fromScale(
                    math.random(),
                    math.random()
                )
                bar.Size = UDim2.new(
                    math.random(10, 80) / 100,
                    0,
                    0,
                    math.random(2, 8)
                )
            end
        end

        for _, particle in ipairs(particles) do
            particle.Position = UDim2.fromScale(
                math.random(),
                math.random()
            )
        end

        -- RANDOM FLASH
        if math.random(1, 4) == 1 then
            flash.BackgroundTransparency = 0.82

            TweenService:Create(
                flash,
                TweenInfo.new(0.2),
                {BackgroundTransparency = 1}
            ):Play()
        end

        -- TITLE GLITCH
        title.Position = UDim2.fromScale(
            math.random(20, 30) / 100,
            0.19
        )

        task.wait(0.12)
    end
end)

-- PANEL ENTRANCE
