-- ANIMATION ENGINE
local active = true

task.spawn(function()
    while active and gui.Parent do
        gradient.Rotation = (gradient.Rotation + 3) % 360

        for _, label in ipairs(backgroundTexts) do
            label.Position = UDim2.fromScale(
                math.random(),
